menu "CSI Receive Configuration"

    config CSI_PUBLIC_WIFI_SSID
        string "Public Wi-Fi SSID"
        default ""
        help
            SSID used by csi_recv to connect the public/local Wi-Fi network
            that carries UDP CSI packets.

    config CSI_PUBLIC_WIFI_PASSWORD
        string "Public Wi-Fi password"
        default ""
        help
            Password for the public/local Wi-Fi network.

    config CSI_AP_CHANNEL
        int "CSI SoftAP channel"
        range 1 13
        default 11
        help
            Set this to the channel used by the public Wi-Fi AP.
            Both interfaces must use the same channel in APSTA mode.

    config CSI_UDP_PORT
        int "UDP destination port"
        range 1 65535
        default 5005

    config CSI_UDP_TARGET_IP
        string "UDP destination IP"
        default "255.255.255.255"
        help
            Set to 255.255.255.255 for LAN broadcast, or set a specific
            computer/server IP for unicast.

endmenu
